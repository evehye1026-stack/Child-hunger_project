# 식품의약품안전처 식품영양성분DB API (data.go.kr 공공데이터포털에서 발급)
# https://various.foodsafetykorea.go.kr/nutrient/ or data.go.kr 활용신청 후 받은 서비스키
FOOD_NUTRITION_API_BASE_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo01
FOOD_NUTRITION_API_KEY=

# 원본 식약처 영양DB 전체 CSV(298,271건) 경로. `npm run db:build` 실행 시 이 파일을
# 읽어 data/food.db(raw_foods 테이블)로 적재한다. 비워두면 scripts/build-food-db.mjs의
# 기본 경로를 사용한다.
RAW_FOOD_CSV_PATH=

# Supabase (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오맵 API (Kakao Developers > 내 애플리케이션 > JavaScript 키)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=