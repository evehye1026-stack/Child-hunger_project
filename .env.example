# 원본 식약처 영양DB 전체 CSV(298,271건) 경로. `npm run db:build` 실행 시 이 파일을
# 읽어 data/food.db(raw_foods 테이블)로 적재한다. 비워두면 scripts/build-food-db.mjs의
# 기본 경로를 사용한다.
RAW_FOOD_CSV_PATH=

# Supabase (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오맵 API (Kakao Developers > 내 애플리케이션 > JavaScript 키)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=

# Gemini API (Google AI Studio > Get API key 에서 발급). 챗봇(든든이)이 규칙 기반으로
# 판단한 답변의 말투만 더 자연스럽게 다듬는 데 쓴다. 비워두면 원래 문장을 그대로 쓴다.
GEMINI_API_KEY=
# 기본값 gemini-flash-latest. 다른 모델을 쓰고 싶을 때만 채운다.
GEMINI_MODEL=